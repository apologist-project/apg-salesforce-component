<?xml version="1.0" encoding="UTF-8"?>
<PermissionSet xmlns="http://soap.sforce.com/2006/04/metadata">
    <description>Allows callouts through the Apologist_Agent External Credential principal.</description>
    <hasActivationRequired>false</hasActivationRequired>
    <label>Apologist Agent Callout</label>
    <externalCredentialPrincipalAccesses>
        <enabled>true</enabled>
        <externalCredentialPrincipal>Apologist_Agent-ApologistAgentPrincipal</externalCredentialPrincipal>
    </externalCredentialPrincipalAccesses>
    <pageAccesses>
        <apexPage>ApologistApiSession</apexPage>
        <enabled>true</enabled>
    </pageAccesses>
    <classAccesses>
        <apexClass>ApologistAgentService</apexClass>
        <enabled>true</enabled>
    </classAccesses>
    <classAccesses>
        <apexClass>ApologistConversationContext</apexClass>
        <enabled>true</enabled>
    </classAccesses>
    <servicePresenceStatusAccesses>
        <enabled>true</enabled>
        <servicePresenceStatus>Available_Messaging</servicePresenceStatus>
    </servicePresenceStatusAccesses>
</PermissionSet>
